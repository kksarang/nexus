rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return isStaff();
    }

    function canOperate() {
      return isStaff();
    }

    function fairPoints() {
      return request.resource.data.paidMinutes is int
        && request.resource.data.paidMinutes >= 0
        && request.resource.data.paidMinutes <= int((request.resource.data.endedAt - request.resource.data.startedAt) / 60000)
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= int(request.resource.data.paidMinutes / 60) + 1;
    }

    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /phones/{phone} {
      allow get: if isStaff();
      allow list: if false;
      allow create: if canOperate()
        && request.resource.data.customerId is string
        && request.resource.data.phoneE164 == "+91" + phone;
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isStaff();
      allow create, update: if canOperate();
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isStaff();
      allow create: if canOperate() && (
        (request.resource.data.status == "active"
          && request.resource.data.points == 0
          && request.resource.data.paidMinutes == 0
          && request.resource.data.startedAt is number
          && request.resource.data.endedAt == request.resource.data.startedAt)
        || (request.resource.data.status == "completed"
          && request.resource.data.startedAt is number
          && request.resource.data.endedAt is number
          && request.resource.data.endedAt >= request.resource.data.startedAt
          && fairPoints())
      );
      allow update: if canOperate()
        && (resource.data.status == "active" || resource.data.paidMinutes == 0)
        && request.resource.data.status == "completed"
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.stationId == resource.data.stationId
        && request.resource.data.endedAt >= request.resource.data.startedAt
        && fairPoints();
      allow delete: if false;
    }

    match /weeklyProgress/{id} {
      allow read: if isStaff();
      allow create, update: if canOperate();
      allow delete: if false;
    }

    match /pointsLedger/{id} {
      allow read: if isStaff();
      allow create: if canOperate();
      allow update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isStaff();
      allow create: if canOperate();
      allow update, delete: if false;
    }

    match /stations/{stationId} {
      // Public: holds only status, an expected free time, and a short reason. Never player details.
      allow read: if true;
      allow create, update: if canOperate()
        && stationId in ["01", "02", "03", "04", "05", "06"]
        && request.resource.data.keys().hasOnly(["status", "until", "reason", "by", "updatedAt"])
        && request.resource.data.status in ["available", "busy", "unavailable"]
        && (request.resource.data.get("until", null) == null || request.resource.data.until is number)
        && request.resource.data.get("reason", "") is string
        && request.resource.data.get("reason", "").size() <= 60
        && request.resource.data.by == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
