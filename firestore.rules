rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isStaff() && staffData().get("role", "admin") == "admin";
    }

    function canOperate() {
      return isStaff();
    }

    function canEdit(module) {
      return isAdmin() || (isStaff() && staffData().get("access", {}).get(module, "none") == "edit");
    }

    function validAccess() {
      return request.resource.data.access.keys().hasOnly(["customers", "gaming", "members", "history", "revenue", "loyalty", "reports"])
        && request.resource.data.access.customers in ["none", "view", "edit"]
        && request.resource.data.access.gaming in ["none", "view", "edit"]
        && request.resource.data.access.members in ["none", "view", "edit"]
        && request.resource.data.access.history in ["none", "view", "edit"]
        && request.resource.data.access.revenue in ["none", "view", "edit"]
        && request.resource.data.access.loyalty in ["none", "view", "edit"]
        && request.resource.data.access.reports in ["none", "view", "edit"];
    }

    function fairPoints() {
      return request.resource.data.paidMinutes is int
        && request.resource.data.paidMinutes >= 0
        && request.resource.data.paidMinutes <= int((request.resource.data.endedAt - request.resource.data.startedAt) / 60000)
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= int(request.resource.data.paidMinutes / 60) + 1;
    }

    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["name", "email", "username", "role", "access", "addedBy", "addedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.role in ["admin", "office"]
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time
        && (
          (request.resource.data.role == "admin" && !request.resource.data.keys().hasAny(["access", "username"]))
          || (request.resource.data.role == "office"
            && request.resource.data.username is string
            && request.resource.data.username.size() > 0
            && request.resource.data.username.size() <= 60
            && validAccess())
        );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "access"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["access"])
          || (resource.data.get("role", "admin") == "office" && validAccess())
        );
      // Removing a staff record only ends desk access; their sessions and changes stay.
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /phones/{phone} {
      allow get: if isStaff();
      allow list: if false;
      allow create: if (canEdit("customers") || canEdit("gaming") || canEdit("members"))
        && request.resource.data.customerId is string
        && request.resource.data.phoneE164 == "+91" + phone;
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isStaff();
      allow create, update: if canEdit("customers") || canEdit("gaming");
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isStaff();
      allow create: if canEdit("gaming") && (
        (request.resource.data.status == "active"
          && request.resource.data.points == 0
          && request.resource.data.paidMinutes == 0
          && request.resource.data.startedAt is number
          && request.resource.data.endedAt == request.resource.data.startedAt)
        || (request.resource.data.status == "completed"
          && request.resource.data.startedAt is number
          && request.resource.data.endedAt is number
          && request.resource.data.endedAt >= request.resource.data.startedAt
          && fairPoints())
      );
      allow update: if canEdit("gaming") && (
        (
          resource.data.status == "active"
          && request.resource.data.status == "active"
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.stationId == resource.data.stationId
          && request.resource.data.paidMinutes == 0
          && request.resource.data.points == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["endsAt", "bookedMinutes", "extraMinutes"])
          && request.resource.data.endsAt is number
          && request.resource.data.endsAt >= resource.data.startedAt
          && request.resource.data.bookedMinutes is int
          && request.resource.data.extraMinutes is int
        )
        || (
          (resource.data.status == "active" || resource.data.paidMinutes == 0)
          && request.resource.data.status == "completed"
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.stationId == resource.data.stationId
          && request.resource.data.endedAt >= request.resource.data.startedAt
          && fairPoints()
        )
      ) || (isAdmin()
        && resource.data.status == "completed"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["amountRupees", "paymentRecorded"])
        && request.resource.data.amountRupees is int
        && request.resource.data.amountRupees >= 0
        && request.resource.data.amountRupees <= 100000
        && request.resource.data.paymentRecorded == (request.resource.data.amountRupees > 0)
      );
      allow delete: if false;
    }

    // Monthly memberships are set up by staff only and are never deleted; cancelling keeps the record.
    match /memberships/{id} {
      allow read: if isStaff();
      allow create: if canEdit("members")
        && request.resource.data.status == "active"
        && request.resource.data.sessionsUsed == 0
        && request.resource.data.sessionsTotal is int
        && request.resource.data.sessionsTotal > 0
        && request.resource.data.sessionsTotal <= 400
        && request.resource.data.amountPaid is int
        && request.resource.data.amountPaid >= 0
        && request.resource.data.startAt is number
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.customerId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (canEdit("members")
        && resource.data.status == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sessionsUsed", "lastUsedAt", "endAt", "status", "note"])
        && request.resource.data.sessionsUsed is int
        && request.resource.data.sessionsUsed >= 0
        && request.resource.data.sessionsUsed <= resource.data.sessionsTotal
        && request.resource.data.status in ["active", "cancelled"]
        && request.resource.data.endAt > resource.data.startAt)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["amountPaid"])
          && request.resource.data.amountPaid is int
          && request.resource.data.amountPaid >= 0
          && request.resource.data.amountPaid <= 100000
        );
      allow delete: if false;
    }

    match /membershipUses/{id} {
      allow read: if isStaff();
      allow create: if canEdit("members") || canEdit("gaming");
      allow update, delete: if false;
    }

    match /weeklyProgress/{id} {
      allow read: if isStaff();
      allow create, update: if canEdit("gaming") || canEdit("loyalty");
      allow delete: if false;
    }

    match /pointsLedger/{id} {
      allow read: if isStaff();
      allow create: if canEdit("gaming") || canEdit("loyalty");
      allow update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isStaff();
      allow create: if canOperate();
      allow update, delete: if false;
    }

    match /stations/{stationId} {
      // Public: holds only status, an expected free time, and a short reason. Never player details.
      allow read: if true;
      allow create, update: if canEdit("gaming")
        && stationId in ["01", "02", "03", "04", "05", "06"]
        && request.resource.data.keys().hasOnly(["status", "until", "reason", "by", "updatedAt"])
        && request.resource.data.status in ["available", "busy", "unavailable"]
        && (request.resource.data.get("until", null) == null || request.resource.data.until is number)
        && request.resource.data.get("reason", "") is string
        && request.resource.data.get("reason", "").size() <= 60
        && request.resource.data.by == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validPrices() {
      return request.resource.data.keys().hasOnly(["station", "simulator", "privateRoom", "memberSessions", "memberRupees", "quarterSessions", "quarterRupees", "yearSessions", "yearRupees", "updatedBy", "updatedAt"])
        && request.resource.data.station is int
        && request.resource.data.station >= 1
        && request.resource.data.station <= 10000
        && request.resource.data.simulator is int
        && request.resource.data.simulator >= 1
        && request.resource.data.simulator <= 10000
        && request.resource.data.privateRoom is int
        && request.resource.data.privateRoom >= 1
        && request.resource.data.privateRoom <= 10000
        && request.resource.data.memberSessions is int
        && request.resource.data.memberSessions >= 1
        && request.resource.data.memberSessions <= 400
        && request.resource.data.memberRupees is int
        && request.resource.data.memberRupees >= 0
        && request.resource.data.memberRupees <= 500000
        && request.resource.data.quarterSessions is int
        && request.resource.data.quarterSessions >= 1
        && request.resource.data.quarterSessions <= 400
        && request.resource.data.quarterRupees is int
        && request.resource.data.quarterRupees >= 0
        && request.resource.data.quarterRupees <= 500000
        && request.resource.data.yearSessions is int
        && request.resource.data.yearSessions >= 1
        && request.resource.data.yearSessions <= 400
        && request.resource.data.yearRupees is int
        && request.resource.data.yearRupees >= 0
        && request.resource.data.yearRupees <= 500000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /settings/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        (id == "notice"
          && request.resource.data.keys().hasOnly(["text", "active", "until", "updatedBy", "updatedAt"])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 160
          && request.resource.data.active is bool
          && (request.resource.data.until == null || request.resource.data.until is number)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time)
        || (id == "prices" && validPrices())
      );
      allow delete: if false;
    }
  }
}
